{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "targetDefaults": {
    "restore": {
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/intermediates/{projectRoot}/obj"]
    },
    "format": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.editorconfig",
        "{workspaceRoot}/.gitignore",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/oxlint.config.ts",
        {
          "externalDependencies": ["oxfmt", "oxlint"]
        }
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    }
  },
  "plugins": ["@nx/dotnet"]
}
